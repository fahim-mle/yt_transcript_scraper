# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL over the Unix socket (peer auth, no password) — simplest:
DATABASE_URL=postgresql:///yt_transcripts
# Or with explicit credentials over TCP:
#   DATABASE_URL=postgresql://user:password@localhost:5432/yt_transcripts

# ── Storage paths ─────────────────────────────────────────────────────────────
BLOB_OUTPUT_DIR=/media/ghost/external_storage/yt_transcripts
CLEAN_OUTPUT_DIR=/srv/dbdata/markdowns/yt_transcripts_structured

# ── LLM provider ──────────────────────────────────────────────────────────────
# Both LLM stages talk to one gateway, so switching between a local model and a
# hosted one is these settings and nothing else.
#
#   ollama → local, free, slow. Uses OLLAMA_HOST below.
#   openai → any OpenAI-compatible /chat/completions endpoint. "openai" is the
#            wire protocol, not the vendor.
LLM_PROVIDER=ollama
#
# Hosted example — GLM via Z.ai. Base URL has NO trailing /chat/completions:
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.z.ai/api/paas/v4
#LLM_API_KEY=your-key-here
#REWRITE_MODEL=glm-4.6
#ENRICH_MODEL=glm-4.5-air
#
# Mainland China endpoint instead:
#LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#
# Extra JSON merged into every request, for provider-specific knobs. GLM-4.5+
# bills thinking tokens you do not need for a rewrite:
#LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
#
# How this pipeline is billed. Controls whether recorded token counts can be
# turned into a cost. 'subscription' means the marginal cost of a call is zero,
# so no dollar figure is invented for it; 'api' means runs are priceable from
# the model_pricing table. Tokens are recorded either way, so switching later
# lets you price the entire history retroactively.
LLM_BILLING_MODE=subscription

# Give up on a video after this many failed attempts in a stage. Without a
# ceiling one broken video sits at the head of the FIFO queue forever and
# starves everything behind it. Requeue with: main.py requeue --stage rewrite
QUEUE_MAX_ATTEMPTS=3

# ── LLM enrichment ────────────────────────────────────────────────────────────
# Set LLM_ENABLED=0 to skip enrichment entirely; the rest of the pipeline runs
# unchanged.
LLM_ENABLED=1
OLLAMA_HOST=http://localhost:11434
# Every setting here overrides the matching default in config.py. Commented-out
# lines fall back to that default, so leaving one alone is always safe — the
# defaults are the values the project is actually run with.
#ENRICH_MODEL=qwen3.5:9b
# Context window — must hold the (capped) transcript + prompt + output.
OLLAMA_NUM_CTX=8192
# Max transcript words sent to the model (longer inputs are truncated).
LLM_MAX_INPUT_WORDS=5000
# Per-request timeout in seconds (CPU inference can be slow).
LLM_TIMEOUT_SECONDS=600

# ── Article rewrite (Ollama) ──────────────────────────────────────────────────
# The `rewrite` stage turns cleaned caption prose into a readable article. It is
# lossless by design — chunks are rewritten, never summarised, and a coverage
# guard falls back to verbatim text rather than let content go missing.
# This is the slowest stage: it generates roughly one token per transcript token.
REWRITE_ENABLED=1
# Independent of OLLAMA_MODEL on purpose — rewriting rewards a strong writer,
# enrichment only needs a competent JSON filler. Must fit in free RAM: a model
# larger than available memory swaps and collapses to a fraction of its speed.
#REWRITE_MODEL=gemma4:e4b
# Source words per LLM call. Chunks break on paragraph/chapter boundaries, so
# a heavily chaptered video produces more, smaller chunks than this suggests.
REWRITE_CHUNK_WORDS=900
# Words of the previous chunk's output replayed so prose flows across seams.
REWRITE_CONTEXT_WORDS=80
REWRITE_NUM_CTX=8192
REWRITE_TIMEOUT_SECONDS=900
# Coverage guard. Output/input word ratio must land in the band, and this
# fraction of the chunk's distinctive content words must survive.
REWRITE_MIN_RATIO=0.55
REWRITE_MAX_RATIO=1.60
REWRITE_MIN_RETENTION=0.72
REWRITE_MAX_ATTEMPTS=2
# Persist each finished chunk so an interrupted rewrite resumes instead of
# regenerating hours of prose from chunk 1. Leave this on.
REWRITE_CHECKPOINT=1
